# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.5.0
ignore:
  SNYK-JS-PICOMATCH-21248802:
    - '*':
        reason: >-
          No upstream fix is published yet (latest picomatch 4.x release is
          4.0.4, which already has this issue). picomatch is pulled in
          transitively via sass -> @parcel/watcher -> picomatch, and is only
          used at build time by the Sass file watcher during asset
          compilation - it never runs against attacker-controlled input in
          production. Revisit and remove this ignore once a patched
          picomatch version is released.
        expires: 2026-12-30T00:00:00.000Z
patch: {}
